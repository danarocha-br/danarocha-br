{
  "name": "profile-cards",
  "private": true,
  "type": "module",
  "description": "Animated SVG cards for the GitHub profile README, refreshed daily.",
  "scripts": {
    "fetch": "node scripts/fetch-data.mjs",
    "render": "node scripts/render-cards.mjs",
